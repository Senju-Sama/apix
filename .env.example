# ==============================================================================
# OPERATION APIx: Environment Configuration
# Problem Statement: SIH26056 (MoSPI)
# ==============================================================================

# Database URL:
# 1. Local Development (Default): SQLite
DATABASE_URL=sqlite:///database/apix.db

# 2. Production (Supabase PostgreSQL):
# Uncomment and fill when hosting on Supabase:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Anti-Bot & Network
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
CIRCUIT_BREAKER_FAIL_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=1800

# Optional: Rotating Proxies (if using proxy provider for production scraping)
# PROXY_SERVER=
# PROXY_USERNAME=
# PROXY_PASSWORD=
